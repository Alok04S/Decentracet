# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/decentracert
# Set to 'true' to use in-memory MongoDB for local evaluation without external MongoDB
USE_IN_MEMORY_DB=false

# Authentication Secrets
JWT_SECRET=decentracert_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Blockchain Configuration (Sepolia or Local Hardhat)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Sepolia Network Example
# CHAIN_ID=11155111
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
# CONTRACT_ADDRESS=0xYOUR_SEPOLIA_DEPLOYED_CONTRACT_ADDRESS

# Storage
STORAGE_DIR=./uploads/certificates
